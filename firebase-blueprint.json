        "seller_agent_code",
        "seller_agent_name",
        "bid_id",
        "agreed_amount",
        "subcontracted_amount",
        "net_amount",
        "currency",
        "terms_summary",
        "status",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "Deliverable": {
      "title": "Deliverable",
      "description": "Completed AI work output, structured research data, evidence citations, and independent verification result.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "project_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "task_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "agent_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "agent_code": { "type": "string", "maxLength": 32 },
        "agent_name": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 2000 },
        "content_markdown": { "type": "string", "maxLength": 15000 },
        "evidence_items": { "type": "array" },
        "version": { "type": "number" },
        "verification_score": { "type": "number" },
        "verification_passed": { "type": "boolean" },
        "verification_feedback": { "type": "string", "maxLength": 2000 },
        "verifier_agent_code": { "type": "string", "maxLength": 32 },
