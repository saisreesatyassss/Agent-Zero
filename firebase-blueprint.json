    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Immutable double-entry accounting record tracking debits and credits across customer escrow and agent accounts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "project_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transaction_group_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "account_id": { "type": "string", "maxLength": 128 },
        "owner_type": { "type": "string", "enum": ["customer", "escrow", "agent"], "maxLength": 32 },
        "owner_code": { "type": "string", "maxLength": 64 },
        "owner_name": { "type": "string", "maxLength": 120 },
        "account_type": { "type": "string", "enum": ["funding", "escrow_liability", "gross_revenue", "subcontract_expense", "net_earnings"], "maxLength": 64 },
        "direction": { "type": "string", "enum": ["debit", "credit"], "maxLength": 16 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD"], "maxLength": 8 },
        "reference_type": { "type": "string", "maxLength": 64 },
        "reference_id": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "project_id",
        "transaction_group_id",
        "account_id",
        "owner_type",
        "owner_code",
        "owner_name",
        "account_type",
        "direction",
        "amount",
        "currency",
        "reference_type",
        "reference_id",
        "description",
        "ownerId",
        "createdAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "PayPal Sandbox Orders v2 authorization and capture record with webhook verification state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "project_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "paypal_order_id": { "type": "string", "maxLength": 128 },
        "authorization_id": { "type": "string", "maxLength": 128 },
        "capture_id": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD"], "maxLength": 8 },
        "status": {
          "type": "string",
          "enum": ["created", "approved", "authorized", "captured", "voided", "refunded"],
          "maxLength": 32
        },
        "mode": { "type": "string", "enum": ["paypal_sandbox_live", "paypal_sandbox_protocol"], "maxLength": 64 },
        "approval_url": { "type": "string", "maxLength": 1000 },
        "webhook_verified": { "type": "boolean" },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "project_id",
        "paypal_order_id",
        "authorization_id",
        "capture_id",
        "amount",
        "currency",
        "status",
        "mode",
        "approval_url",
        "webhook_verified",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AgentMessage": {
      "title": "AgentMessage",
      "description": "Structured AEP/1.0 protocol message exchanged between autonomous agents.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "project_id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "protocol": { "type": "string", "enum": ["AEP/1.0"], "maxLength": 16 },
        "message_id": { "type": "string", "maxLength": 64 },
        "message_type": {
          "type": "string",
          "enum": [
            "TASK_PUBLISH",
            "TASK_DISCOVER",
            "BID_SUBMIT",
            "BID_REJECT",
            "BID_COUNTER",
            "CONTRACT_AWARD",
            "SUBTASK_CREATE",
            "TASK_START",
            "DELIVERABLE_SUBMIT",
            "VERIFICATION_RESULT",
            "PAYMENT_APPROVAL",
            "LEDGER_CREDIT"
          ],
          "maxLength": 64
        },
        "sender_agent_code": { "type": "string", "maxLength": 32 },
        "recipient_agent_code": { "type": "string", "maxLength": 32 },
        "task_id": { "type": "string", "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 1000 },
        "payload_json": { "type": "string", "maxLength": 5000 },
        "ownerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "project_id",
        "protocol",
        "message_id",
        "message_type",
        "sender_agent_code",
        "recipient_agent_code",
        "task_id",
        "summary",
        "payload_json",
        "ownerId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/Agent" },
      "description": "Registered autonomous agents in the marketplace."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Customer-funded economic projects."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Tasks and subcontracted child tasks."
    },
    "/bids/{bidId}": {
      "schema": { "$ref": "#/entities/Bid" },
      "description": "Agent bids and negotiation counteroffers."
    },
    "/contracts/{contractId}": {
      "schema": { "$ref": "#/entities/Contract" },
      "description": "Awarded commercial contracts."
    },
    "/deliverables/{deliverableId}": {
      "schema": { "$ref": "#/entities/Deliverable" },
      "description": "Submitted agent deliverables and Veritas verification results."
    },
    "/ledger_entries/{entryId}": {
      "schema": { "$ref": "#/entities/LedgerEntry" },
      "description": "Immutable double-entry ledger records."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "PayPal Sandbox Orders v2 authorizations, captures, and webhook events."
    },
    "/agent_messages/{messageId}": {
      "schema": { "$ref": "#/entities/AgentMessage" },
      "description": "AEP/1.0 protocol messages emitted during execution."
    }
  }
}
