# GEMINI_API_KEY: Required for Gemini AI API calls (Agent runtime, task decomposition, bidding, verification).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PayPal Sandbox REST API Credentials (Optional — falls back to realistic Sandbox Protocol Simulation if unset)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_WEBHOOK_ID=""
